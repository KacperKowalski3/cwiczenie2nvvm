<Window x:Class="cwiczenie2nvvm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cwiczenie2nvvm"
        xmlns:vm="clr-namespace:cwiczenie2nvvm.ViewModels"
        mc:Ignorable="d"
        Title="Ćwiczenie" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <StackPanel Orientation="Vertical">
        <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Pracownicy}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Imie" Width="Auto" Binding="{Binding imie}"/>
                <DataGridTextColumn Header="Nazwisko" Width="Auto" Binding="{Binding nazwisko}"/>
                <DataGridTextColumn Header="Wynagrodzenie" Width="Auto" Binding="{Binding wynagrodzenie}"/>
                <DataGridTextColumn Header="Zatrudniony" Width="Auto" Binding="{Binding dataZatrudnienia, StringFormat=dd.MM.yyyy}"/>
                <DataGridTextColumn Header="Zwolniony" Width="Auto" Binding="{Binding dataKoncaZatrudnienia}"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Window>
